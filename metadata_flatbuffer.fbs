namespace BlorgMetaFlat;

table DirectoryEntryMetadata {
    size:uint64;
    created:uint64;
    modified:uint64;
    accessed:uint64;
    directory:bool;
    // The entry's own security descriptor, self-relative, when one is
    // stored; absent when it inherits from the directory it is in.
    security:[ubyte];
}

table FileEntryMetadata {
    name:string;
    size:uint64;
    created:uint64;
    modified:uint64;
    accessed:uint64;
    // k is the listing's security[k - 1]; 0, the default, inherits.
    security:uint32;
}

table SubdirectoryMetadata {
    name:string;
    created:uint64;
    modified:uint64;
    accessed:uint64;
    // As FileEntryMetadata.security.
    security:uint32;
}

// A self-relative security descriptor, stored once per listing however many
// entries carry it.
table Security {
    descriptor:[ubyte];
}

table Directory {
    subdirectories: [SubdirectoryMetadata];
    files: [FileEntryMetadata];
    descendants: [Descendant];
    security: [Security];
}

// The listing of subdirectory `subdirectory` of listing `parent`, where 0 is
// the directory asked for and k is descendants[k - 1]. Breadth first, so a
// parent always comes before its children.
table Descendant {
    parent:uint32;
    subdirectory:uint32;
    listing:Directory;
}

table ChangeBatch {
    epoch:uint64;
    generation:uint64;
    reset:bool;
    modified:[string];
    created:[string];
    removed:[string];
}
