namespace BlorgMetaFlat;

table DirectoryEntryMetadata {
    size:uint64;
    created:uint64;
    modified:uint64;
    accessed:uint64;
    directory:bool;
    // The entry's own security descriptor, self-relative, when one is
    // stored; absent when it inherits from the directory it is in.
    security:[ubyte];
    // When it inherits: the descriptor of the nearest directory above it
    // that has one stored, and how many levels up that directory is. Absent
    // when none does, in which case it inherits from the client's default
    // for the root.
    inherited:[ubyte];
    inherited_depth:uint32;
}

table FileEntryMetadata {
    name:string;
    size:uint64;
    created:uint64;
    modified:uint64;
    accessed:uint64;
    // k is the listing's security[k - 1]; 0, the default, inherits.
    security:uint32;
}

table SubdirectoryMetadata {
    name:string;
    created:uint64;
    modified:uint64;
    accessed:uint64;
    // As FileEntryMetadata.security.
    security:uint32;
}

// A self-relative security descriptor, stored once per listing however many
// entries carry it.
table Security {
    descriptor:[ubyte];
}

table Directory {
    subdirectories: [SubdirectoryMetadata];
    files: [FileEntryMetadata];
    descendants: [Descendant];
    security: [Security];
    // What the listed directory itself resolves to: its own descriptor at
    // depth 0, or the nearest stored one above it and how many levels up.
    // Absent when none is stored up to the root. An entry with security 0
    // inherits from this, one level further down.
    inherited:[ubyte];
    inherited_depth:uint32;
}

// The listing of subdirectory `subdirectory` of listing `parent`, where 0 is
// the directory asked for and k is descendants[k - 1]. Breadth first, so a
// parent always comes before its children.
table Descendant {
    parent:uint32;
    subdirectory:uint32;
    listing:Directory;
}

table ChangeBatch {
    epoch:uint64;
    generation:uint64;
    reset:bool;
    modified:[string];
    created:[string];
    removed:[string];
}
