namespace BlorgMetaFlat;

table DirectoryEntryMetadata {
    size:uint64;
    created:uint64;
    modified:uint64;
    accessed:uint64;
    directory:bool;
}

table FileEntryMetadata {
    name:string;
    size:uint64;
    created:uint64;
    modified:uint64;
    accessed:uint64;
}

table SubdirectoryMetadata {
    name:string;
    created:uint64;
    modified:uint64;
    accessed:uint64;
}

table Directory {
    subdirectories: [SubdirectoryMetadata];
    files: [FileEntryMetadata];
    descendants: [Descendant];
}

// The listing of subdirectory `subdirectory` of listing `parent`, where 0 is
// the directory asked for and k is descendants[k - 1]. Breadth first, so a
// parent always comes before its children.
table Descendant {
    parent:uint32;
    subdirectory:uint32;
    listing:Directory;
}

table ChangeBatch {
    epoch:uint64;
    generation:uint64;
    reset:bool;
    modified:[string];
    created:[string];
    removed:[string];
}
